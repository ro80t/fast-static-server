{
  "name": "fast-static-server-workspace",
  "private": true,
  "workspaces": [
    "bench"
  ],
  "type": "module",
  "scripts": {
    "bench": "turbo run bench",
    "lint": "oxlint -c oxlint.config.ts .",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "publish:cargo": "cargo publish -p fast-static-server && cargo publish -p fss-cli",
    "publish:npm": "bun packages/fss-cli/npm/publish.ts",
    "publish:jsr": "cd packages/fss-cli/jsr && npx jsr publish",
    "publish:all": "bun run publish:cargo && bun run publish:npm && bun run publish:jsr"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "turbo": "^2.11.2"
  },
  "packageManager": "bun@1.4.2"
}
